ENVIRONMENT=development
LOG_LEVEL=DEBUG
DATABASE_URL=postgresql://user:password@localhost:5432/aries
DATABASE_ECHO=true
REDIS_URL=redis://localhost:6379/0
API_HOST=127.0.0.1
API_PORT=8000
LLM_PROVIDER=ollama
LLM_MODEL=neural-chat
LLM_BASE_URL=http://localhost:11434
VOICE_ENABLED=true
SECRET_KEY=change-me-in-production
# Requerida para POST /message y POST /message/confirm (GET /health nunca la
# pide). Vacío = el servidor rechaza esos dos endpoints. Generar una propia,
# no dejar vacío ni copiar un valor de ejemplo — ver
# docs/audits/2026-09-23-security-audit.md.
API_KEY=
# Raíz permitida para FileSystemAgent/DatabaseAgent (path absoluto). Vacío =
# esos dos agentes fallan cerrado en cualquier acción de archivo/DB.
FILESYSTEM_ALLOWED_ROOT=
